# --- Supabase (free project: https://supabase.com/dashboard) ------------------
# Leave these empty to run in demo mode from the seeded fixtures in supabase/fixtures.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_… (legacy anon key also works)
# Server-only. Used by the cron ingest, the narrator cache and the ask panel.
SUPABASE_SECRET_KEY=                    # sb_secret_… (legacy service_role key also works)

# --- Unusual Whales ----------------------------------------------------------------
# Optional. Enables fresh scoring and Live Radar. Signed-in users can also bring their own key.
UW_API_KEY=

# --- Anthropic ----------------------------------------------------------------------
# Optional. Enables the Narrator story, Dossier summary and the Ask panel.
ANTHROPIC_API_KEY=
# NARRATOR_MODEL=claude-haiku-5-5

# --- App ---------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Protects /api/cron/ingest. Vercel sends it as a Bearer token.
CRON_SECRET=
# Optional, for email alerts.
RESEND_API_KEY=
ALERTS_FROM_EMAIL=alerts@foreshadow.app
